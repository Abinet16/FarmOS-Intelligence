{
  "name": "farmos",
  "private": true,
  "description": "FarmOS Intelligence — multi-tenant farm operations and decision-support platform",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:migration:new": "pnpm --filter @farmos/api db:migration:new",
    "db:generate": "pnpm --filter @farmos/api prisma:generate"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.11.10"
  }
}
