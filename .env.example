# Copy to .env (root, used by docker compose) and apps/api/.env
POSTGRES_USER=farmos
POSTGRES_PASSWORD=farmos_dev_password
POSTGRES_DB=farmos
# Host ports; change if 5432/6379 are taken by another project
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://farmos:farmos_dev_password@localhost:5432/farmos?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
