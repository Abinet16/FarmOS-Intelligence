# Copy to .env (root). Used by docker compose. API settings live in apps/api/.env.example.
POSTGRES_USER=farmos
POSTGRES_PASSWORD=farmos_dev_password
POSTGRES_DB=farmos
# Host ports; change if 5432/6379 are taken by another project
POSTGRES_PORT=5432
REDIS_PORT=6379
# Only needed for `docker compose --profile app up` (the containerised API)
APP_DB_USER=farmos_api
APP_DB_PASSWORD=farmos_api_dev_password
BETTER_AUTH_SECRET=replace-me-with-a-long-random-secret-value
