// FarmOS Intelligence — relational model
//
// Conventions (see docs/architecture/data-model.md):
// - UUID primary keys, UTC timestamptz, snake_case tables and columns.
// - Every tenant-owned row carries organization_id, and every parent that a
//   tenant-owned row points at exposes a unique (organization_id, id) key.
//   Child rows reference parents through that composite key, so the database
//   itself rejects a row that links to another tenant's farm, batch, etc.
// - CHECK constraints and the append-only audit trigger live in the migration
//   SQL because Prisma's schema language cannot express them.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("organization_status")
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED

  @@map("user_status")
}

enum Role {
  OWNER
  MANAGER
  SUPERVISOR
  FIELD_WORKER
  VETERINARIAN
  AUDITOR

  @@map("role")
}

enum BatchStatus {
  PLANNED
  ACTIVE
  DEPLETED
  CLOSED

  @@map("batch_status")
}

enum FlockPurpose {
  LAYER
  BROILER
  BREEDER

  @@map("flock_purpose")
}

enum MortalityReason {
  DISEASE
  INJURY
  PREDATOR
  HEAT_STRESS
  CULLED
  UNKNOWN
  OTHER

  @@map("mortality_reason")
}

enum RecordStatus {
  SUBMITTED
  APPROVED

  @@map("record_status")
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("correction_status")
}

enum VaccinationStatus {
  SCHEDULED
  ADMINISTERED
  MISSED
  CANCELLED

  @@map("vaccination_status")
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("severity")
}

enum ResolutionStatus {
  OPEN
  MONITORING
  RESOLVED

  @@map("resolution_status")
}

enum MovementType {
  RECEIPT
  ISSUE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT

  @@map("movement_type")
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED

  @@map("alert_status")
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED

  @@map("job_status")
}

enum AiMessageRole {
  USER
  ASSISTANT
  TOOL

  @@map("ai_message_role")
}

// ─────────────────────── Tenancy and identity ───────────────────────

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  name      String
  slug      String             @unique
  timezone  String             @default("UTC")
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships           Membership[]
  farms                 Farm[]
  houses                House[]
  flockBatches          FlockBatch[]
  productionLogs        ProductionLog[]
  productionCorrections ProductionLogCorrection[]
  mortalityEvents       MortalityEvent[]
  feedTypes             FeedType[]
  feedUsage             FeedUsage[]
  weightSamples         WeightSample[]
  vaccines              Vaccine[]
  vaccinationRecords    VaccinationRecord[]
  healthEvents          HealthEvent[]
  inventoryItems        InventoryItem[]
  inventoryMovements    InventoryMovement[]
  alerts                Alert[]
  auditLogs             AuditLog[]
  reportJobs            ReportJob[]
  aiConversations       AiConversation[]

  @@map("organizations")
}

/// Better Auth owns the identity columns (email, email_verified, image);
/// FarmOS adds status. Users are disabled, never deleted, so actor history stays intact.
model User {
  id            String     @id @default(uuid()) @db.Uuid
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false) @map("email_verified")
  image         String?
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships Membership[]
  sessions    Session[]
  accounts    Account[]

  productionLogCreators      ProductionLog[]           @relation("ProductionLogCreator")
  productionLogApprovers     ProductionLog[]           @relation("ProductionLogApprover")
  correctionRequesters       ProductionLogCorrection[] @relation("CorrectionRequester")
  correctionReviewers        ProductionLogCorrection[] @relation("CorrectionReviewer")
  mortalityRecorders         MortalityEvent[]          @relation("MortalityRecorder")
  feedUsageRecorders         FeedUsage[]               @relation("FeedUsageRecorder")
  weightSampleRecorders      WeightSample[]            @relation("WeightSampleRecorder")
  vaccinationRecorders       VaccinationRecord[]       @relation("VaccinationRecorder")
  healthEventRecorders       HealthEvent[]             @relation("HealthEventRecorder")
  inventoryMovementRecorders InventoryMovement[]       @relation("InventoryMovementRecorder")
  mortalityVoiders           MortalityEvent[]          @relation("MortalityVoider")
  feedUsageVoiders           FeedUsage[]               @relation("FeedUsageVoider")
  weightSampleVoiders        WeightSample[]            @relation("WeightSampleVoider")
  auditActors                AuditLog[]                @relation("AuditActor")
  reportRequesters           ReportJob[]               @relation("ReportRequester")
  aiConversationUsers        AiConversation[]          @relation("AiConversationUser")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// One row per sign-in method. For email/password, provider_id = "credential"
/// and password holds the hash (scrypt, managed by Better Auth).
model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           Role
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

// ─────────────────────── Farm structure ───────────────────────

model Farm {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  location       String?
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  houses             House[]
  inventoryMovements InventoryMovement[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("farms")
}

model House {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  farmId         String    @map("farm_id") @db.Uuid
  name           String
  capacity       Int
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  farm         Farm         @relation(fields: [organizationId, farmId], references: [organizationId, id], onDelete: Restrict)
  flockBatches FlockBatch[]

  @@unique([organizationId, id])
  @@unique([organizationId, farmId, name])
  @@map("houses")
}

model FlockBatch {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  houseId        String       @map("house_id") @db.Uuid
  batchCode      String       @map("batch_code")
  breed          String
  purpose        FlockPurpose @default(LAYER)
  placementDate  DateTime     @map("placement_date") @db.Date
  endDate        DateTime?    @map("end_date") @db.Date
  initialBirds   Int          @map("initial_birds")
  status         BatchStatus  @default(PLANNED)
  notes          String?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  house              House               @relation(fields: [organizationId, houseId], references: [organizationId, id], onDelete: Restrict)
  productionLogs     ProductionLog[]
  mortalityEvents    MortalityEvent[]
  feedUsage          FeedUsage[]
  weightSamples      WeightSample[]
  vaccinationRecords VaccinationRecord[]
  healthEvents       HealthEvent[]
  alerts             Alert[]

  @@unique([organizationId, id])
  @@unique([organizationId, batchCode])
  @@index([organizationId, houseId])
  @@index([organizationId, status])
  @@map("flock_batches")
}

// ─────────────────────── Operational records ───────────────────────

model ProductionLog {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  batchId          String       @map("batch_id") @db.Uuid
  logDate          DateTime     @map("log_date") @db.Date
  eggsCollected    Int          @default(0) @map("eggs_collected")
  waterConsumption Decimal?     @map("water_consumption_litres") @db.Decimal(12, 2)
  notes            String?
  status           RecordStatus @default(SUBMITTED)
  createdBy        String       @map("created_by") @db.Uuid
  approvedBy       String?      @map("approved_by") @db.Uuid
  approvedAt       DateTime?    @map("approved_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  approver     User?                     @relation("ProductionLogApprover", fields: [approvedBy], references: [id], onDelete: Restrict)
  creator      User                      @relation("ProductionLogCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  batch        FlockBatch                @relation(fields: [organizationId, batchId], references: [organizationId, id], onDelete: Restrict)
  corrections  ProductionLogCorrection[]

  @@unique([organizationId, id])
  @@unique([organizationId, batchId, logDate])
  @@index([organizationId, logDate])
  @@map("production_logs")
}

/// Approved production logs are never overwritten in place. A change is
/// proposed here and applied only after a supervisor or manager approves it.
model ProductionLogCorrection {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  productionLogId String           @map("production_log_id") @db.Uuid
  proposedChanges Json             @map("proposed_changes")
  reason          String
  status          CorrectionStatus @default(PENDING)
  requestedBy     String           @map("requested_by") @db.Uuid
  reviewedBy      String?          @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?        @map("reviewed_at") @db.Timestamptz(3)
  reviewNote      String?          @map("review_note")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  reviewer      User?         @relation("CorrectionReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict)
  requester     User          @relation("CorrectionRequester", fields: [requestedBy], references: [id], onDelete: Restrict)
  productionLog ProductionLog @relation(fields: [organizationId, productionLogId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, status])
  @@map("production_log_corrections")
}

model MortalityEvent {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  batchId        String          @map("batch_id") @db.Uuid
  eventDate      DateTime        @map("event_date") @db.Date
  quantity       Int
  reasonCode     MortalityReason @map("reason_code")
  notes          String?
  recordedBy     String          @map("recorded_by") @db.Uuid
  voidedAt       DateTime?       @map("voided_at") @db.Timestamptz(3)
  voidedBy       String?         @map("voided_by") @db.Uuid
  voidReason     String?         @map("void_reason")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recorder     User         @relation("MortalityRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)
  voider       User?        @relation("MortalityVoider", fields: [voidedBy], references: [id], onDelete: Restrict)
  batch        FlockBatch   @relation(fields: [organizationId, batchId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, batchId, eventDate])
  @@map("mortality_events")
}

model FeedType {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  feedUsage    FeedUsage[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("feed_types")
}

model FeedUsage {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  batchId        String    @map("batch_id") @db.Uuid
  feedTypeId     String    @map("feed_type_id") @db.Uuid
  usageDate      DateTime  @map("usage_date") @db.Date
  quantityKg     Decimal   @map("quantity_kg") @db.Decimal(12, 3)
  recordedBy     String    @map("recorded_by") @db.Uuid
  voidedAt       DateTime? @map("voided_at") @db.Timestamptz(3)
  voidedBy       String?   @map("voided_by") @db.Uuid
  voidReason     String?   @map("void_reason")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recorder     User         @relation("FeedUsageRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)
  voider       User?        @relation("FeedUsageVoider", fields: [voidedBy], references: [id], onDelete: Restrict)
  batch        FlockBatch   @relation(fields: [organizationId, batchId], references: [organizationId, id], onDelete: Restrict)
  feedType     FeedType     @relation(fields: [organizationId, feedTypeId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, batchId, usageDate])
  @@map("feed_usage")
}

model WeightSample {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  batchId            String    @map("batch_id") @db.Uuid
  sampleDate         DateTime  @map("sample_date") @db.Date
  sampleSize         Int       @map("sample_size")
  averageWeightGrams Decimal   @map("average_weight_grams") @db.Decimal(10, 2)
  recordedBy         String    @map("recorded_by") @db.Uuid
  voidedAt           DateTime? @map("voided_at") @db.Timestamptz(3)
  voidedBy           String?   @map("voided_by") @db.Uuid
  voidReason         String?   @map("void_reason")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recorder     User         @relation("WeightSampleRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)
  voider       User?        @relation("WeightSampleVoider", fields: [voidedBy], references: [id], onDelete: Restrict)
  batch        FlockBatch   @relation(fields: [organizationId, batchId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, batchId, sampleDate])
  @@map("weight_samples")
}

// ─────────────────────── Health ───────────────────────

model Vaccine {
  id                      String   @id @default(uuid()) @db.Uuid
  organizationId          String   @map("organization_id") @db.Uuid
  name                    String
  recommendedIntervalDays Int?     @map("recommended_interval_days")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vaccinationRecords VaccinationRecord[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("vaccines")
}

model VaccinationRecord {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  batchId        String            @map("batch_id") @db.Uuid
  vaccineId      String            @map("vaccine_id") @db.Uuid
  scheduledDate  DateTime          @map("scheduled_date") @db.Date
  administeredAt DateTime?         @map("administered_at") @db.Timestamptz(3)
  status         VaccinationStatus @default(SCHEDULED)
  recordedBy     String?           @map("recorded_by") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recorder     User?        @relation("VaccinationRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)
  batch        FlockBatch   @relation(fields: [organizationId, batchId], references: [organizationId, id], onDelete: Restrict)
  vaccine      Vaccine      @relation(fields: [organizationId, vaccineId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, batchId, scheduledDate])
  @@index([organizationId, status, scheduledDate])
  @@map("vaccination_records")
}

model HealthEvent {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  batchId          String           @map("batch_id") @db.Uuid
  observedAt       DateTime         @map("observed_at") @db.Timestamptz(3)
  category         String
  severity         Severity
  description      String
  resolutionStatus ResolutionStatus @default(OPEN) @map("resolution_status")
  recordedBy       String           @map("recorded_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recorder     User         @relation("HealthEventRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)
  batch        FlockBatch   @relation(fields: [organizationId, batchId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, batchId, observedAt])
  @@map("health_events")
}

// ─────────────────────── Inventory ───────────────────────

model InventoryItem {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  unit           String
  reorderLevel   Decimal? @map("reorder_level") @db.Decimal(14, 3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  movements    InventoryMovement[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("inventory_items")
}

/// Stock balances are derived from movements; quantity is always positive and
/// movement_type carries the direction.
model InventoryMovement {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  itemId         String       @map("item_id") @db.Uuid
  farmId         String       @map("farm_id") @db.Uuid
  movementType   MovementType @map("movement_type")
  quantity       Decimal      @db.Decimal(14, 3)
  occurredAt     DateTime     @map("occurred_at") @db.Timestamptz(3)
  reference      String?
  /// Shared by the TRANSFER_OUT and TRANSFER_IN rows of one transfer.
  transferId     String?      @map("transfer_id") @db.Uuid
  recordedBy     String       @map("recorded_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recorder     User          @relation("InventoryMovementRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)
  item         InventoryItem @relation(fields: [organizationId, itemId], references: [organizationId, id], onDelete: Restrict)
  farm         Farm          @relation(fields: [organizationId, farmId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, itemId, farmId, occurredAt])
  @@map("inventory_movements")
}

// ─────────────────────── Derived intelligence ───────────────────────

model Alert {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  batchId        String?     @map("batch_id") @db.Uuid
  ruleCode       String      @map("rule_code")
  severity       Severity
  status         AlertStatus @default(OPEN)
  /// Deterministic key (rule + subject + window) so job retries cannot raise duplicates.
  dedupeKey      String      @map("dedupe_key")
  details        Json?
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  batch        FlockBatch?  @relation(fields: [organizationId, batchId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, status, createdAt])
  @@map("alerts")
}

/// Append-only. UPDATE and DELETE are blocked by a trigger in the migration.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}

model ReportJob {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  requestedBy    String    @map("requested_by") @db.Uuid
  reportType     String    @map("report_type")
  parameters     Json?
  /// Client-supplied key so a retried request returns the existing job.
  idempotencyKey String    @map("idempotency_key")
  status         JobStatus @default(QUEUED)
  fileKey        String?   @map("file_key")
  error          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requester    User         @relation("ReportRequester", fields: [requestedBy], references: [id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@map("report_jobs")
}

model AiConversation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation("AiConversationUser", fields: [userId], references: [id], onDelete: Restrict)
  messages     AiMessage[]

  @@unique([organizationId, id])
  @@index([organizationId, userId, createdAt])
  @@map("ai_conversations")
}

model AiMessage {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  conversationId   String        @map("conversation_id") @db.Uuid
  role             AiMessageRole
  content          String
  /// Tool calls, record references and model/provider metadata backing the answer.
  evidenceMetadata Json?         @map("evidence_metadata")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation AiConversation @relation(fields: [organizationId, conversationId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, conversationId, createdAt])
  @@map("ai_messages")
}
