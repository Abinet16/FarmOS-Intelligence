# Runtime connection: a login role that is a member of farmos_app (no BYPASSRLS).
# Create it with `pnpm --filter @farmos/api db:app-user` after migrating.
DATABASE_URL=postgresql://farmos_api:farmos_api_dev_password@localhost:5432/farmos?schema=public
# Owner connection: used only for migrations, seeding and owner-level tests.
MIGRATION_DATABASE_URL=postgresql://farmos:farmos_dev_password@localhost:5432/farmos?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
# Public URL of this API (Better Auth builds callback URLs from it)
BETTER_AUTH_URL=http://localhost:4000
# At least 32 random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-secret-value
