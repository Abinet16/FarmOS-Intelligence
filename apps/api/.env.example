# Runtime connection: a login role that is a member of farmos_app (no BYPASSRLS).
# Create it with `pnpm --filter @farmos/api db:app-user` after migrating.
DATABASE_URL=postgresql://farmos_api:farmos_api_dev_password@localhost:5432/farmos?schema=public
# Owner connection: used only for migrations, seeding and owner-level tests.
MIGRATION_DATABASE_URL=postgresql://farmos:farmos_dev_password@localhost:5432/farmos?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
# Public URL of this API (Better Auth builds callback URLs from it)
BETTER_AUTH_URL=http://localhost:4000
# At least 32 random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-secret-value
# Behind a load balancer, set how many proxies to trust (e.g. 1) so rate limits
# see real client addresses. Leave unset when clients connect directly.
# TRUST_PROXY=1
# AI assistant (optional). Without a key the assistant endpoints answer 503.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_DAILY_QUESTION_LIMIT=50
# Background jobs and reports. Run the worker with `pnpm --filter @farmos/api worker:dev`.
# QUEUE_PREFIX=farmos
# REPORTS_DIR=var/reports
# REPORT_RETENTION_DAYS=7
# ALERT_EVALUATION_CRON=15 * * * *
# MAIL_TRANSPORT=log
# MAIL_FROM=FarmOS <no-reply@farmos.local>
# WEB_URL=http://localhost:3000
# Database connections per process, and the longest any statement may run.
# DATABASE_POOL_MAX=10
# DATABASE_STATEMENT_TIMEOUT_MS=30000
# Logs: "json" for log collectors, "pretty" for terminals; level debug|log|warn|error.
# LOG_FORMAT=pretty
# LOG_LEVEL=log
# GET /metrics (Prometheus) is off until this is set; send it as a bearer token.
# METRICS_TOKEN=
# Requests per signed-in user per minute, per API instance.
# RATE_LIMIT_PER_MINUTE=300
